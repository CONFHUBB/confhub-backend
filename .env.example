# ═══════════════════════════════════════════
#  ConfHub Backend — .env.example
#  Copy this file to .env and fill in real values.
#  ⚠️  NEVER commit real secrets to this file!
# ═══════════════════════════════════════════

# ── Database ──
DB_HOST=localhost
DB_PORT=5433
DB_NAME=confhub_db
DB_USERNAME=confhub_user
DB_PASSWORD=your_db_password

# ── JWT ──
JWT_SECRET=your_jwt_secret_base64_encoded

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id

# ── Email (SMTP) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ── App URLs ──
APP_BASE_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000

# ── CORS Allowed Origins (comma-separated) ──
APP_CORS_ORIGINS=http://localhost:3000,https://your-tunnel.yourdomain.com

# ── VNPAY ──
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECRET_KEY=your_vnpay_secret_key
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payment/vnpay-callback

# ── Gemini AI ──
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2

# ── Google Custom Search (Plagiarism) ──
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id
